# Gravit - Development Environment Variables
# Copy to backend/.env.dev

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gravit_dev
POSTGRES_USER=gravit_user
POSTGRES_PASSWORD=gravit12345

# Application Configuration
SECRET_KEY=your-super-secret-dev-key-change-this
ANALYTICS_SECRET_KEY=your-analytics-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
INVITE_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://dev-gravit.taydens.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
REDIS_URL=memory://

# Admin User (for initial setup)
FIRST_SUPERUSER=dharanidaran.a@taydens.com
FIRST_SUPERUSER_PASSWORD=Testpass@123

# Email Configuration (optional for dev)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=s.mail25.info
SMTP_USER=dharanidaran.a@winvinaya.com
SMTP_PASSWORD=Admin##2025@
EMAILS_FROM_EMAIL=dharanidaran.a@winvinaya.com
EMAILS_FROM_NAME=Gravit

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png","doc","docx"]

# API Documentation
PROJECT_NAME="Gravit - Development"
