# Application Configuration
APP_NAME=Gravit
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=gravit_db
POSTGRES_PORT=5432

# Redis Configuration (OPTIONAL - not needed for local development)
# Rate limiting uses in-memory storage by default
# Uncomment these if you want to use Redis for production
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Security
SECRET_KEY=qwertyuiopasdfghjklzxcvbnm1234567890
ANALYTICS_SECRET_KEY=your-analytics-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
INVITE_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=500 MB
LOG_RETENTION=30 days
LOG_FORMAT=json

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Email Configuration (optional - for future use)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=s.mail25.info
SMTP_USER=dharanidaran.a@winvinaya.com
SMTP_PASSWORD=Admin##2025@
EMAILS_FROM_EMAIL=dharanidaran.a@winvinaya.com
EMAILS_FROM_NAME=Gravit

# AI Engine
AI_ENABLED=True

# Active provider. Supported: gemini | openai | anthropic | groq | mistral | together | cohere | ollama
AI_PROVIDER=groq
# Secondary provider tried once if the primary is fully unavailable (all Groq keys rate-limited,
# provider outage, etc). Leave blank to disable cross-provider fallback.
AI_FALLBACK_PROVIDER=gemini

# Groq key pool — up to 3 keys, rotated automatically on rate-limit so a single key's limit
# never interrupts a user. Only the keys you set are used; 1 is enough to run, 3 is recommended.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Other provider keys (only needed if you set AI_PROVIDER/AI_FALLBACK_PROVIDER to use them)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Model selection per provider (defaults are already sensible — override only if needed)
AI_MODEL_GROQ=openai/gpt-oss-20b
AI_MODEL_GEMINI=gemini-3.5-flash-lite
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-3-5-haiku-20241022
AI_MODEL_MISTRAL=mistral-small-latest

# AI credits: 1 credit = AI_CREDIT_TOKEN_RATIO tokens at multiplier 1.0 (Groq/Gemini baseline);
# pricier providers cost more credits per token via AI_PROVIDER_COST_MULTIPLIER (see config.py).
AI_CREDIT_TOKEN_RATIO=1000