# Gravit - QA Environment Variables
# Copy to backend/.env.qa

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gravit_qa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Application Configuration
SECRET_KEY=your-super-secret-qa-key-change-this
ANALYTICS_SECRET_KEY=your-analytics-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INVITE_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=qa

# CORS Configuration
BACKEND_CORS_ORIGINS=["https://qa.gravit.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
REDIS_URL=memory://

# Admin User
FIRST_SUPERUSER=dharanidaran.a@taydens.com
FIRST_SUPERUSER_PASSWORD=Testpass@123

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@gravit.com

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png","doc","docx"]

# API Documentation
PROJECT_NAME="Gravit - QA"
